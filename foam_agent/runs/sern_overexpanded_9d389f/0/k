FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1.0;
    }
    ramp_wall
    {
        type            kqRWallFunction;
        value           uniform 1.0;
    }
    cowl_wall
    {
        type            kqRWallFunction;
        value           uniform 1.0;
    }
    outlet
    {
        type            zeroGradient;
    }
    farfield
    {
        type            fixedValue;
        value           uniform 1.0;
    }
    frontAndBack
    {
        type            empty;
    }
}
