FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 100.0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 100.0;
    }
    ramp_wall
    {
        type            epsilonWallFunction;
        value           uniform 100.0;
    }
    cowl_wall
    {
        type            epsilonWallFunction;
        value           uniform 100.0;
    }
    outlet
    {
        type            zeroGradient;
    }
    farfield
    {
        type            fixedValue;
        value           uniform 100.0;
    }
    frontAndBack
    {
        type            empty;
    }
}
