FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (25 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (25 0 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    casing
    {
        type            noSlip;
    }
    hub
    {
        type            noSlip;
    }
    rotorBlades
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }
    statorBlades
    {
        type            noSlip;
    }
    periodic1
    {
        type            cyclic;
    }
    periodic2
    {
        type            cyclic;
    }
}

