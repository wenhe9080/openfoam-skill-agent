FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.9375;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.9375;
    }
    outlet
    {
        type            zeroGradient;
    }
    casing
    {
        type            kqRWallFunction;
        value           uniform 0.9375;
    }
    hub
    {
        type            kqRWallFunction;
        value           uniform 0.9375;
    }
    rotorBlades
    {
        type            kqRWallFunction;
        value           uniform 0.9375;
    }
    statorBlades
    {
        type            kqRWallFunction;
        value           uniform 0.9375;
    }
    periodic1
    {
        type            cyclic;
    }
    periodic2
    {
        type            cyclic;
    }
}

