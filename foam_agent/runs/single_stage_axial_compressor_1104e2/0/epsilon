FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 15;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 15;
    }
    outlet
    {
        type            zeroGradient;
    }
    hub
    {
        type            epsilonWallFunction;
        value           uniform 15;
    }
    casing
    {
        type            epsilonWallFunction;
        value           uniform 15;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}
