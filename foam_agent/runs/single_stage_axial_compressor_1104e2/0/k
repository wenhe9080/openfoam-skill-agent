FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.6;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.6;
    }
    outlet
    {
        type            zeroGradient;
    }
    hub
    {
        type            kqRWallFunction;
        value           uniform 0.6;
    }
    casing
    {
        type            kqRWallFunction;
        value           uniform 0.6;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}
