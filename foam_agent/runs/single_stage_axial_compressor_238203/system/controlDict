FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     pimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.1;
deltaT          1e-4;
writeControl    timeStep;
writeInterval   100;
purgeWrite      3;
frequency       1;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           0.5;
