FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

// Dimensions: [0 2 -1 0 0 0 0]
dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-4;

boundaryField
{
    inlet
    {
        type            calculated;
    }
    outlet
    {
        type            calculated;
    }
    wall
    {
        type            nutkWallFunction;
        value           uniform 1e-4;
    }
    symmetryPlane
    {
        type            symmetryPlane;
    }
}
