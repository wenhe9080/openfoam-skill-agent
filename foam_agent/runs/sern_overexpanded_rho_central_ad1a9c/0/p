FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

// Dimensions: [1 -1 -2 0 0 0 0] (Pressure)
dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 31073.02;

boundaryField
{
    inlet
    {
        type            zeroGradient; // Total pressure handled via boundary condition in rhoCentralFoam or initial field
    }
    outlet
    {
        type            waveTransmissive;
        fieldInf        31073.02;
        lInf            1000;
        gamma           1.4;
    }
    wall
    {
        type            zeroGradient;
    }
    symmetryPlane
    {
        type            symmetryPlane;
    }
}
