FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      rho;
}

// Dimensions: [1 -3 0 0 0 0 0] (Density)
dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 0.36;

boundaryField
{
    inlet
    {
        type            calculated;
    }
    outlet
    {
        type            calculated;
    }
    wall
    {
        type            calculated;
    }
    symmetryPlane
    {
        type            symmetryPlane;
    }
}
