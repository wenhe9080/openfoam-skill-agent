FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

// Dimensions: [0 1 -1 0 0 0 0]
dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (300 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (300 0 0); // Approximate sonic velocity at throat
    }
    outlet
    {
        type            waveTransmissive;
        fieldInf        uniform (0 0 0);
        lInf            1000;
        gamma           1.4;
    }
    wall
    {
        type            noSlip;
    }
    symmetryPlane
    {
        type            symmetryPlane;
    }
}
