FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     pimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.2;
deltaT          1e-3;
writeControl    adjustableRunTime;
writeInterval   0.01;
purgeWrite      0;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           1.0;
maxDeltaT       1e-2;
