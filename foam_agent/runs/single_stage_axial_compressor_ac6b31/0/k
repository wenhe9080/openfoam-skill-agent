FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 1.0;
boundaryField
{
    inlet
    {
        type            turbulentInlet;
        referenceField  uniform 1.0;
        fluctuationScale uniform 0.1;
        seed             12345;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 1.0;
    }
    hub
    {
        type            kqRWallFunction;
        value           uniform 1.0;
    }
    casing
    {
        type            kqRWallFunction;
        value           uniform 1.0;
    }
    rotorBlade
    {
        type            kqRWallFunction;
        value           uniform 1.0;
    }
    statorBlade
    {
        type            kqRWallFunction;
        value           uniform 1.0;
    }
    frontBack
    {
        type            empty;
    }
}
