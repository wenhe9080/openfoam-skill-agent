// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 100;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 100;
    }
    outlet
    {
        type            zeroGradient;
    }
    casing
    {
        type            omegaWallFunction;
        value           uniform 100;
    }
    hub
    {
        type            omegaWallFunction;
        value           uniform 100;
    }
    rotorBlades
    {
        type            omegaWallFunction;
        value           uniform 100;
    }
    statorBlades
    {
        type            omegaWallFunction;
        value           uniform 100;
    }
    front
    {
        type            cyclic;
    }
    back
    {
        type            cyclic;
    }
}

