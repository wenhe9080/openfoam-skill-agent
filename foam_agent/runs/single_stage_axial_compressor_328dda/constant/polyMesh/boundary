FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

8
(
    inlet
    {
        type            patch;
        nFaces          20;
        startFace       3880;
    }
    outlet
    {
        type            patch;
        nFaces          20;
        startFace       3900;
    }
    hub
    {
        type            wall;
        inGroups        1(wall);
        nFaces          100;
        startFace       3920;
    }
    casing
    {
        type            wall;
        inGroups        1(wall);
        nFaces          100;
        startFace       4020;
    }
    front
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          2000;
        startFace       4120;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  back;
    }
    back
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          2000;
        startFace       6120;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  front;
    }
    rotorBlades
    {
        type            wall;
        inGroups        1(wall);
        nFaces          0;
        startFace       8120;
    }
    statorBlades
    {
        type            wall;
        inGroups        1(wall);
        nFaces          0;
        startFace       8120;
    }
)

