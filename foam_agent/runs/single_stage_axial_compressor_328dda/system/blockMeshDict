        faces
        (
            (1 5 6 2)
        );
    }
    hub
    {
        type wall;
        faces
        (
            (0 4 5 1)
        );
    }
    casing
    {
        type wall;
        faces
        (
            (3 2 6 7)
        );
    }
    front
    {
        type cyclic;
        neighbourPatch back;
        faces
        (
            (0 1 2 3)
        );
    }
    back
    {
        type cyclic;
        neighbourPatch front;
        faces
        (
            (4 7 6 5)
        );
    }
    rotorBlades
    {
        type wall;
        faces
