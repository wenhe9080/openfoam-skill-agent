FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (39.27 0 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    rotorBlades
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }
    statorBlades
    {
        type            noSlip;
    }
    casing
    {
        type            noSlip;
    }
    hub
    {
        type            noSlip;
    }
    frontBack
    {
        type            empty;
    }
}
