FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 1.0;
boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1.0; // Approx 1% turbulence intensity
    }
    outlet
    {
        type            zeroGradient;
    }
    casing
    {
        type            kqRWallFunction;
        value           uniform 1.0;
    }
    hub
    {
        type            kqRWallFunction;
        value           uniform 1.0;
    }
    frontBack
    {
        type            empty;
    }
}
