FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    topWall
    {
        type            fixedValue;
        value           uniform (1 0 0);
    }
    bottomWall
    {
        type            noSlip;
    }
    leftWall
    {
        type            noSlip;
    }
    rightWall
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}
