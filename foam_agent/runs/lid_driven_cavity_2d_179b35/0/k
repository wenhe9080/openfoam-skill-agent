FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.01;

boundaryField
{
    topWall
    {
        type            kqRWallFunction;
        value           uniform 0.01;
    }
    bottomWall
    {
        type            kqRWallFunction;
        value           uniform 0.01;
    }
    leftWall
    {
        type            kqRWallFunction;
        value           uniform 0.01;
    }
    rightWall
    {
        type            kqRWallFunction;
        value           uniform 0.01;
    }
    frontAndBack
    {
        type            empty;
    }
}
