FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (21.6 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (21.6 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    hub
    {
        type            noSlip;
    }
    shroud
    {
        type            noSlip;
    }
    periodic1
    {
        type            cyclicAMI;
    }
    periodic2
    {
        type            cyclicAMI;
    }
}
