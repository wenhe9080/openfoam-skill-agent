FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.35;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.35;
    }
    outlet
    {
        type            zeroGradient;
    }
    hub
    {
        type            kqRWallFunction;
        value           uniform 0.35;
    }
    shroud
    {
        type            kqRWallFunction;
        value           uniform 0.35;
    }
    periodic1
    {
        type            cyclicAMI;
    }
    periodic2
    {
        type            cyclicAMI;
    }
}
