FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (10 0 0); // Reduced velocity to prevent initial divergence
    }
    outlet
    {
        type            zeroGradient;
    }
    casing
    {
        type            noSlip;
    }
    hub
    {
        type            noSlip;
    }
    frontPlane
    {
        type            empty;
    }
    backPlane
    {
        type            empty;
    }
}
