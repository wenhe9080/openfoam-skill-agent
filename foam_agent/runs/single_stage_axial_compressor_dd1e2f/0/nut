FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1.5e-4;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 1.5e-4;
    }
    outlet
    {
        type            calculated;
        value           uniform 1.5e-4;
    }
    hub
    {
        type            nutkWallFunction;
        value           uniform 1.5e-4;
    }
    casing
    {
        type            nutkWallFunction;
        value           uniform 1.5e-4;
    }
    theta0
    {
        type            wedge;
    }
    theta1
    {
        type            wedge;
    }
}
