FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (300 0 0);
boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (300 0 0);
    }
    outlet
    {
        type            waveTransmissive;
        gammaInf        1.4;
        fieldInf        0;
        lInf            1000;
        value           uniform (300 0 0);
    }
    farfield_top
    {
        type            waveTransmissive;
        gammaInf        1.4;
        fieldInf        0;
        lInf            1000;
        value           uniform (0 0 0);
    }
    farfield_bottom
    {
        type            waveTransmissive;
        gammaInf        1.4;
        fieldInf        0;
        lInf            1000;
        value           uniform (0 0 0);
    }
    wall_upper
    {
        type            noSlip;
    }
    wall_lower
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}
