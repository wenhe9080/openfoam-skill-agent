FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
dimensions      [0 0 0 1 0 0 0];
internalField   uniform 300;
boundaryField
{
    inlet
    {
        type            totalTemperature;
        gamma           1.4;
        T0              300;
        value           uniform 300;
    }
    outlet
    {
        type            waveTransmissive;
        gammaInf        1.4;
        fieldInf        300;
        lInf            1000;
        value           uniform 300;
    }
    farfield_top
    {
        type            waveTransmissive;
        gammaInf        1.4;
        fieldInf        300;
        lInf            1000;
        value           uniform 300;
    }
    farfield_bottom
    {
        type            waveTransmissive;
        gammaInf        1.4;
        fieldInf        300;
        lInf            1000;
        value           uniform 300;
    }
    wall_upper
    {
        type            zeroGradient;
    }
    wall_lower
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
