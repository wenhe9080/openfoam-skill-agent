FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     rhoCentralFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.0001;
deltaT          1e-8;
writeControl    adjustableRunTime;
writeInterval   1e-5;
purgeWrite      0;
adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       1e-6;
runTimeModifiable true;
