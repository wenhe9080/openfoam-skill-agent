FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     icoFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.2;
deltaT          0.001;
writeControl    adjustableRunTime;
writeInterval   0.05;
purgeWrite      0;
timeFormat      general;
precision       6;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       0.01;
