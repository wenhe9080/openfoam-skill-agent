FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1000;
deltaT          5e-05;
writeControl    runTime;
writeInterval   100;
purgeWrite      3;
runTimeModifiable true;
