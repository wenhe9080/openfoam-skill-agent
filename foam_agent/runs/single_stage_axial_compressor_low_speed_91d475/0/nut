FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 1e-5;

boundaryField
{
    inlet
    {
        type            calculated;
    }
    outlet
    {
        type            calculated;
    }
    sideWalls
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    frontBack
    {
        type            empty;
    }
}
